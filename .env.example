DEVICE_ID=rpi_agri_304D
SERVER_URL=http://server:8000
API_KEY=replace-with-the-same-secret-as-server
DATABASE_PATH=/data/sensor.db
IMAGE_DIR=/data/images
LOG_LEVEL=INFO
HTTP_TIMEOUT_SECONDS=10

# SCD41 uses Raspberry Pi I2C bus 1 (physical pins 3 and 5).
SCD41_I2C_BUS=1
SCD41_POLL_SECONDS=1
CAMERA_INTERVAL_SECONDS=10
RGB_CAMERA_INDEX=0

# FLIR Lepton uses SPI0 CE0. The core model is required before setting dimensions.
LEPTON_SPI_BUS=0
LEPTON_SPI_DEVICE=0
LEPTON_I2C_BUS=2
LEPTON_I2C_ADDRESS=0x2A
LEPTON_WIDTH=
LEPTON_HEIGHT=

# HVAC values must match the actual device register map.
MODBUS_PORT=/dev/ttyUSB0
MODBUS_BAUDRATE=9600
MODBUS_SLAVE_ID=
MODBUS_STATE_REGISTER=
MODBUS_CONTROL_REGISTER=
MODBUS_POWER_REGISTER=
