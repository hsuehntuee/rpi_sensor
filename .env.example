DEVICE_ID=rpi_agri_304D
SERVER_URL=http://server:8000
API_KEY=replace-with-the-same-secret-as-server
DATABASE_PATH=/data/sensor.db
IMAGE_DIR=/data/images
LOG_LEVEL=INFO
HTTP_TIMEOUT_SECONDS=10

# 取樣週期設定 (預設每 5 分鐘整點對齊紀錄，例如 10:00, 10:05, 10:10...)
SAMPLE_INTERVAL_MINUTES=5
SAMPLE_CRON_MINUTE=*/5

# SCD41 uses Raspberry Pi I2C bus 2 (physical pins 32 and 33).
SCD41_I2C_BUS=2
RGB_CAMERA_INDEX=0

# FLIR Lepton uses SPI0 CE0. The core model is required before setting dimensions.
LEPTON_SPI_BUS=0
LEPTON_SPI_DEVICE=0
LEPTON_I2C_BUS=1
LEPTON_I2C_ADDRESS=0x2A
LEPTON_WIDTH=160
LEPTON_HEIGHT=120
LEPTON_COLORMAP=rainbow

# HVAC values must match the actual device register map.
MODBUS_PORT=/dev/ttyUSB0
MODBUS_BAUDRATE=9600
MODBUS_SLAVE_ID=
MODBUS_STATE_REGISTER=
MODBUS_CONTROL_REGISTER=
MODBUS_POWER_REGISTER=

# 樹莓派邊緣端內網即時儀表板 (Edge Local Web Dashboard)
EDGE_WEB_ENABLED=true
EDGE_WEB_HOST=0.0.0.0
EDGE_WEB_PORT=8080
