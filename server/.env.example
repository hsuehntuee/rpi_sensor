POSTGRES_DB=rpi_sensor
POSTGRES_USER=rpi_sensor
POSTGRES_PASSWORD=replace-with-a-long-random-password
API_KEY=replace-with-another-long-random-secret
# Change this to the server's actual LAN address, for example 192.168.1.20.
# Do not use 0.0.0.0 when the host also has an Internet-facing interface.
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000
IMAGE_STORAGE_PATH=/data/images
MAX_IMAGE_BYTES=20971520
