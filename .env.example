# ===== 每台樹莓派都要改的 =====
# 裝置名稱（每台不同，會出現在儀表板與上傳的資料裡），例如 rpi_agri_614_rpi0
DEVICE_ID=rpi_edge_01
# 冷氣頁面上顯示的名稱，例如 614 東元
AC_NAME=冷氣

# ===== 資料上傳（有自己的 Server 才填，見 server/README.md）=====
# off = 不上傳，資料全部留在樹莓派；之後填入 Server 網址並重啟，積壓的資料會自動補傳
SERVER_URL=off
# 與 Server 的 .env 裡 API_KEY 相同（SERVER_URL=off 時不用管）
API_KEY=replace-with-the-same-secret-as-server

# ===== 冷氣紅外線遙控（ESP32 用 USB 線接樹莓派）=====
# auto = 自動找 ESP32；off = 停用
AC_SERIAL_PORT=auto
# 留空 = 用 ESP32 韌體寫死的冷氣（燒錄時選的 304D 或 614），一般不用填。
# 要覆寫時：304D 日立 → HITACHI_AC1 + AC_MODEL=R-LT0541-HTA-B；614 東元 → ELECTRA_AC
AC_PROTOCOL=
AC_MODEL=

# ===== 以下通常不用改 =====
TZ=Asia/Taipei
DATABASE_PATH=/data/sensor.db
IMAGE_DIR=/data/images
# WARNING：只記需要處理的狀況（省 SD 卡）；除錯時改 INFO
LOG_LEVEL=WARNING
HTTP_TIMEOUT_SECONDS=10

# 每 5 分鐘整點取樣一次（10:00、10:05…）
SAMPLE_INTERVAL_MINUTES=5
SAMPLE_CRON_MINUTE=*/5

# SCD41 溫濕度/CO2：I2C bus 2（實體腳位 32、33）
SCD41_I2C_BUS=2
RGB_CAMERA_INDEX=0
RGB_WIDTH=1920
RGB_HEIGHT=1080
RGB_QUALITY=85

# 已上傳的照片在樹莓派保留幾天；剩餘空間低於 MIN_DISK_FREE_MB 時自動刪最舊的照片
IMAGE_RETENTION_DAYS=14
MIN_DISK_FREE_MB=1500

# FLIR Lepton 熱影像：SPI0 CE0、I2C bus 1
LEPTON_SPI_BUS=0
LEPTON_SPI_DEVICE=0
LEPTON_I2C_BUS=1
LEPTON_I2C_ADDRESS=0x2A
LEPTON_WIDTH=160
LEPTON_HEIGHT=120
LEPTON_COLORMAP=rainbow
# 選接：Lepton RESET_L 接到樹莓派 Pin 13 (GPIO27) 時填 27，沒接留空
LEPTON_RESET_GPIO=

# 儀表板與 API（內網 http://<樹莓派IP>:8080）
EDGE_WEB_ENABLED=true
EDGE_WEB_HOST=0.0.0.0
EDGE_WEB_PORT=8080
